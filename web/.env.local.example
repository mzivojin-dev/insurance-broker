# Copy to .env.local. These are public IDs (they ship in the browser bundle), not secrets.
# From `terraform output` of the stack that holds the Cognito user pool.
NEXT_PUBLIC_USER_POOL_ID=us-east-1_XXXXXXXXX
NEXT_PUBLIC_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Leave unset to call the API on the same origin (/client_service/chat),
# which is what the dev proxy and prod both give you.
# NEXT_PUBLIC_API=
# Where the dev proxy sends /client_service/* (default: the docker compose gateway)
# AGENTS_ORIGIN=http://localhost:8080

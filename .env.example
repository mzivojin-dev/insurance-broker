ANTHROPIC_API_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
AGENT_MODEL=claude-sonnet-5-5
JUDGE_MODEL=claude-sonnet-5-5
# Tracing: phoenix (local, http://localhost:6006) | langfuse | none
TRACING_BACKEND=phoenix
# Embeddings for RAG (client_service.ingest, search_policy_docs); the SDK reads this exact name
VOYAGE_API_KEY=
# Chat sign-in (client_service /chat). From the Cognito module outputs; public IDs, not secrets.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Gates POST /<agent>/run (the eval harness). Any random string locally: openssl rand -hex 24
EVAL_KEY=
